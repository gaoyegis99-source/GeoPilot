      "basis": "The nearest endpoint nodes are (500000,3500000) and (500060,3500000). Both offsets have component magnitudes 3 m and 4 m, hence 5 m, exactly the permitted limit. Their network route length is 30 + 30 = 60 m, excluding the two offsets."
    }
  },
  "failure_cases": [
    {
      "id": "web-mercator-start",
      "inputs": {
        "start": {"path": "inputs/start-web-mercator.geojson", "sha256": "38d4298fff8d34349d3cdd33968a88dc16d9f8a99fcc4912518e476a6b721208"}
