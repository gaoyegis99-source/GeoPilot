    {
      "id": "provider-unavailable-preserves-manual-fallback", "category": "understanding", "kind": "boundary",
      "goal": "Calculate a shortest route.", "mock": {"error": "MODEL_UNAVAILABLE"},
      "expect": {"phase": "provider", "code": "MODEL_UNAVAILABLE", "provider_calls": 2}
    },
    {
      "id": "invalid-optional-explanation-keeps-draft", "category": "understanding", "kind": "boundary",
      "goal": "Find a shortest road route.",
      "context_method": "road-network-shortest-path@1", "assets": ["network", "start", "end"],
      "mock": {"method": "road-network-shortest-path@1", "summary": "Find a shortest road route", "options": {"target_crs": "EPSG:32650", "snap_tolerance_m": 5}, "extra": {"explanation": {"unsupported": true}}},
      "expect": {"phase": "draft", "clarification": "ready_for_confirmation", "explanation_issue": "MODEL_EXPLANATION_INVALID", "provider_calls": 1}
    },
    {
      "id": "explain-stored-timeout", "category": "failure_explanation", "kind": "positive",
