      "context_method": "road-network-shortest-path@1", "assets": ["network", "start", "end"],
      "assert_options": {"target_crs": "EPSG:32650", "snap_tolerance_m": 0},
      "mock": {"method": "road-network-shortest-path@1", "summary": "Find a shortest route with exact node matching", "options": {"target_crs": "EPSG:32650", "snap_tolerance_m": 0}},
      "expect": {"phase": "draft", "options_match": true, "clarification": "ready_for_confirmation", "issues": [], "gate": ["execution"], "provider_calls": 1}
    },
    {
