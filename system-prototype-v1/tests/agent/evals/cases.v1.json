      "expect": {"phase": "parser", "code": "MODEL_OPTION_UNKNOWN", "field": "options", "provider_calls": 1}
    },
    {
      "id": "block-raw-geometry-before-provider", "category": "overreach", "kind": "refusal", "live": true,
      "goal": "Use raw geometry POINT (1 2) to find a shortest route.",
      "mock": {"method": "road-network-shortest-path@1", "summary": "Find a shortest route"},
      "expect": {"phase": "outbound", "code": "OUTBOUND_DATA_REJECTED", "field": "goal.summary", "provider_calls": 0}
