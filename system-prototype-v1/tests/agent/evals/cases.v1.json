      "goal": "Find a shortest road route.",
      "context_method": "road-network-shortest-path@1", "assets": ["network", "start", "end"],
      "mock": {"method": "road-network-shortest-path@1", "summary": "Find a shortest road route", "options": {"target_crs": "EPSG:32650", "snap_tolerance_m": -1}},
      "expect": {"phase": "draft", "clarification": "blocked", "issues": ["INVALID_OPTION:critical_options.snap_tolerance_m"], "gate": ["confirmation"], "provider_calls": 1}
    },
    {
