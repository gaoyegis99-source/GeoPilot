{
  "$defs": {
    "CheckStatus": {
      "enum": [
        "NOT_CHECKED",
        "CHECKING",
        "PASSED",
        "WARNING",
        "FAILED"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "phase": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Phase",
          "type": "string"
        },
        "step_key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Step Key",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "suggestion": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Suggestion",
          "type": "string"
        },
        "log_path": {
          "anyOf": [
            {
              "description": "Slash-separated local path relative to the run root, without traversal or URI delimiters.",
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Log Path"
        },
        "observed": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "code",
        "phase",
        "step_key",
        "field",
        "message",
        "suggestion",
        "log_path"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "NOT_STARTED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "plan_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_version": {
      "exclusiveMinimum": 0,
      "title": "Plan Version",
      "type": "integer"
    },
    "workdir": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Workdir",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution_status": {
      "$ref": "#/$defs/ExecutionStatus",
      "default": "NOT_STARTED"
    },
    "check_status": {
      "$ref": "#/$defs/CheckStatus",
      "default": "NOT_CHECKED"
    },
    "cancel_requested": {
      "default": false,
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "current_step": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Step"
    },
    "current_report_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Report Id"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "plan_id",
    "plan_version",
    "workdir",
    "created_at"
  ],
  "title": "Run",
  "type": "object"
}
